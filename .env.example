# Puerto de escucha del servidor del Gemelo Digital
PORT=3000

# URL pública o local de la aplicación
APP_URL=http://localhost:3000

# Conexión con Langflow
# Local: http://127.0.0.1:7860 | Docker Compose: http://langflow:7860
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=5948dff7-734a-4820-b301-9c1632f078fc
LANGFLOW_API_KEY=your_langflow_api_key_here

# Clave de API de Google Gemini (opcional para diagnósticos directos de IA)
GEMINI_API_KEY=your_gemini_api_key_here
